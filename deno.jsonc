// Sprout workspace root. This file is JSONC (JSON with comments) and is read
// by Deno 2.x as the workspace config plus the shared compilerOptions, fmt,
// lint, and import map. Each member package has its own minimal deno.jsonc
// that only declares name, version, and exports; the settings below are
// inherited automatically.
{
  "workspace": [
    "packages/core",
    "packages/cli",
    "packages/config",
    "packages/compiler",
    "packages/jsx",
    "packages/runtime",
    "packages/utils",
    "examples/*"
  ],
  "nodeModulesDir": "none",
  "exclude": [
    "node_modules",
    ".git",
    ".github",
    ".opencode",
    ".sprout",
    "dist",
    "coverage",
    "docs",
    "examples",
    "tests/fixtures",
    "tests/.tmp",
    "tests/examples"
  ],
  "tasks": {
    "check": "deno check packages/*/mod.ts",
    "test": "deno test --allow-all",
    "test-examples": "deno test --allow-all --no-check --config tests/examples/deno.json tests/examples/examples_test.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "ci": "deno fmt --check && deno lint && deno task check && deno task check-sprout-versions && deno task test",
    "smoke": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run --allow-sys --allow-ffi scripts/smoke.ts",
    "check-hono-sync": "deno run --allow-read scripts/check_hono_sync.ts",
    "check-sprout-versions": "deno run --allow-read scripts/check_sprout_versions.ts",
    "publish-check": "deno publish --dry-run --config packages/utils/deno.jsonc --allow-dirty && deno publish --dry-run --config packages/config/deno.jsonc --allow-dirty && deno publish --dry-run --config packages/compiler/deno.jsonc --allow-dirty && deno publish --dry-run --config packages/jsx/deno.jsonc --allow-dirty && deno publish --dry-run --config packages/runtime/deno.jsonc --allow-dirty && deno publish --dry-run --config packages/core/deno.jsonc --allow-dirty && deno publish --dry-run --config packages/cli/deno.jsonc --allow-dirty"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@sprout/jsx",
    "lib": [
      "deno.window",
      "deno.worker",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/encoding": "jsr:@std/encoding@^1.0.5",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "esbuild": "jsr:@ggpwnkthx/esbuild@0.2.8",
    "@ggpwnkthx/esbuild-plugin-deno": "jsr:@ggpwnkthx/esbuild-plugin-deno@0.2.8",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@hono/hono": "jsr:@hono/hono@4.12.24"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "singleQuote": false,
    "semiColons": true
  }
}
