// @sprout/core — primary public server package: Hono-backed `createApp` /
// `serve`, route method dispatch, HTML shell, public-file and
// framework-asset serving for both dev and production.
{
  "name": "@sprout/core",
  "version": "0.2.0",
  "description": "Primary public server package: Hono-backed `createApp` / `serve`, route method dispatch, HTML shell, public-file and framework-asset serving for both dev and production.",
  "license": "MIT",
  "imports": {
    "@hono/hono": "jsr:@hono/hono@4.12.24",
    "@hono/hono/jsx": "jsr:@hono/hono@4.12.24/jsx",
    "@hono/hono/html": "jsr:@hono/hono@4.12.24/html"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "**/*_test.tsx",
      "**/*_test.js",
      "**/*_test.jsx",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.test.jsx",
      ".DS_Store",
      ".github",
      ".vscode"
    ]
  }
}
