// @sprout/runtime — browser-only island mounting. The framework-owned
// mount loop: scans `[data-sprout-src]` placeholders, imports island
// modules, validates props, and mounts components.
{
  "name": "@sprout/runtime",
  "version": "0.2.0",
  "description": "Browser-only island mounting. The framework-owned mount loop: scans `[data-sprout-src]` placeholders, imports island modules, validates props, and mounts components.",
  "license": "MIT",
  "imports": {
    "@sprout/jsx/dom": "jsr:@sprout/jsx@0.2.0/dom",
    "@sprout/jsx/shared": "jsr:@sprout/jsx@0.2.0/shared"
  },
  "exports": {
    ".": "./mod.ts",
    "./runtime_entry.ts": "./runtime_entry.ts"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "**/*_test.tsx",
      "**/*_test.js",
      "**/*_test.jsx",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.test.jsx",
      ".DS_Store",
      ".github",
      ".vscode"
    ]
  }
}
