// @sprout/compiler — route / island / style discovery, internal manifest
// construction, on-demand dev asset compilation, and content-hashed
// production build with a frozen manifest.
{
  "name": "@sprout/compiler",
  "version": "0.2.0",
  "description": "Route / island / style discovery, internal manifest construction, on-demand dev asset compilation, and content-hashed production build with a frozen manifest.",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "**/*_test.tsx",
      "**/*_test.js",
      "**/*_test.jsx",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.test.jsx",
      ".DS_Store",
      ".github",
      ".vscode"
    ]
  }
}
