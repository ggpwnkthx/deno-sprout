// @sprout/config — defines and validates the Sprout project configuration.
// Produces a fully resolved config with absolute, slash-normalized paths.
{
  "name": "@sprout/config",
  "version": "0.2.0",
  "description": "Defines and validates the Sprout project configuration. Produces a fully resolved config with absolute, slash-normalized paths.",
  "license": "MIT",
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8",
    "@sprout/utils": "jsr:@sprout/utils@0.2.0"
  },
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "**/*_test.tsx",
      "**/*_test.js",
      "**/*_test.jsx",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.test.js",
      "**/*.test.jsx",
      ".DS_Store",
      ".github",
      ".vscode"
    ]
  }
}
