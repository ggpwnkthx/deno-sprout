{
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run @sprout/cli dev",
    "build": "deno run --allow-read --allow-write --allow-env --allow-net --allow-run jsr:@sprout/cli@0.2.0 build",
    "serve": "deno run --allow-read --allow-env --allow-net jsr:@sprout/cli@0.2.0 serve"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@sprout/jsx"
  }
  // "imports": {
  //   "@sprout/core": "jsr:@sprout/core@0.2.0",
